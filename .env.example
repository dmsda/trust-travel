# ==============================================================================
# TRUST.TRAVEL — Environment Configuration Template
# ==============================================================================
# Note: In development and demo mode, all features work with local sample datasets.
# No secret keys or real payment gateways are connected by default.

# Application Base URL
NEXT_PUBLIC_SITE_URL=https://trust.travel

# Demo Currency Configuration (USD, EUR, GBP, JPY)
NEXT_PUBLIC_DEFAULT_CURRENCY=USD

# Optional External API Placeholders (for future production integrations)
